    {
      "name": "Technical Admin / Lawful Access",
      "description": "⚠️ RESTRICTED: lawful access only.\n\nThese endpoints are for the technical administrator responding to verified requests from law-enforcement or national-security authorities. Create a legal request with case number, authority, country and legal basis, obtain second-admin approval (when enabled), then export. Every step is audited and the export SHA-256 is stored on the request. Passwords, hashes, refresh tokens and verification codes are never exported.",
      "item": [
        {
          "name": "Create legal request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.id) pm.collectionVariables.set('legalRequestID', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_number\": \"CASE-2026-000123\",\n  \"authority\": \"National Police / Cybercrime Unit\",\n  \"country\": \"RU\",\n  \"legal_basis\": \"Court order #1234 dated 2026-01-10\",\n  \"target_user_id\": \"{{targetUserID}}\",\n  \"scopes\": [\"account\", \"profile\", \"media\", \"matches\", \"messages\"],\n  \"reason\": \"Formal written request received by the trust & safety team\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/legal-requests",
            "description": "⚠️ Technical admin only. Registers the legal basis before any data is disclosed."
          }
        },
        {
          "name": "List legal requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/admin/legal-requests",
            "description": "⚠️ Technical admin only. Audited."
          }
        },
        {
          "name": "Get legal request",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/admin/legal-requests/{{legalRequestID}}",
            "description": "⚠️ Technical admin only. Audited."
          }
        },
        {
          "name": "Approve legal request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Second-admin review completed; legal basis verified\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/legal-requests/{{legalRequestID}}/approve",
            "description": "⚠️ Technical admin only. A different administrator must approve when second approval is enabled."
          }
        },
        {
          "name": "Export legal request",
