    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.tokens) {",
                  "  pm.collectionVariables.set('accessToken', body.data.tokens.access_token);",
                  "  pm.collectionVariables.set('refreshToken', body.data.tokens.refresh_token);",
                  "  pm.collectionVariables.set('userID', body.data.user.id);",
                  "}",
                  "if (body.data && body.data.dev_code) console.log('dev verification code:', body.data.dev_code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.user@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"display_name\": \"Новый пользователь\",\n  \"birth_date\": \"1997-06-15\",\n  \"gender\": \"female\",\n  \"phone\": \"+79990001122\",\n  \"preferred_genders\": [\"male\"]\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (demo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.tokens) {",
                  "  pm.collectionVariables.set('accessToken', body.data.tokens.access_token);",
                  "  pm.collectionVariables.set('refreshToken', body.data.tokens.refresh_token);",
                  "  pm.collectionVariables.set('userID', body.data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@loveservice.app\",\n  \"password\": \"LoveDemo123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (technical admin)",
          "event": [
