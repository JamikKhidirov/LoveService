# Copy to .env for local runs outside Docker.
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

# Postgres
DATABASE_URL=postgres://love:love@localhost:5432/love?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka (set KAFKA_ENABLED=false to use the in-process bus)
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=love.events
KAFKA_GROUP_ID=love-notifications

# Auth
JWT_SECRET=change-me-in-production-please-32-bytes-minimum
ACCESS_TTL=15m
REFRESH_TTL=720h

# Media: local | s3
STORAGE_DRIVER=s3
MEDIA_DIR=./media
MEDIA_BASE_URL=http://localhost:8080/media
MAX_UPLOAD_MB=50
AUTO_APPROVE_MEDIA=true

# MinIO / S3 (bucket is created automatically)
S3_ENDPOINT=localhost:9000
S3_PUBLIC_URL=http://localhost:9000/love-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=love-media
S3_REGION=us-east-1
S3_USE_SSL=false

# Web / docs
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=240
DOCS_DIR=./docs
LOG_LEVEL=info

# Demo data and limits
SEED_DEMO=true
DAILY_LIKE_LIMIT=100
DAILY_SUPERLIKE_LIMIT=5
REWIND_WINDOW=5m

# Email delivery (SMTP). Leave SMTP_HOST empty in development: codes are then
# logged and, optionally, written to MAIL_OUTBOX_DIR as .eml files.
# Gmail: smtp.gmail.com:587 + app password. Yandex: smtp.yandex.ru:465 (tls).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LoveService <no-reply@loveservice.local>
# starttls (587) | tls (465, implicit TLS) | none (local relay only)
SMTP_TLS=starttls
SMTP_TIMEOUT=15s
# Development preview: writes every rendered letter as an .eml file here.
MAIL_OUTBOX_DIR=
